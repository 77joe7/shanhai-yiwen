    {
      "id": "IT-V01-MAT-RETURNKNOT",
      "name": "返潮绳结",
      "category": "material",
      "rarity": "rare",
      "sourceTags": ["原创材料"],
      "origin": "归还者号浅滩的三色布头共同系成，记录一条被三方互不信任仍共同走过的回头路",
      "sensoryText": "湿麻绳上有盐、芦根和旧血的气味；握紧时会比周围的水慢半拍收缩。",
      "recognitionStages": [
        {"stage": "first_sight", "displayName": "三色湿绳结", "text": "绳结随倒潮轻颤，像在记一条尚未画出的路。", "effects": []},
        {"stage": "verified", "displayName": "返潮绳结", "text": "可固定一段正在倒退的退路，为旧盐井撤离或证词转移争取一次选择；使用后该路线会失去再次被追溯的可能。", "effects": [{"type": "unlockAction", "action": "anchor_return_route"}]},
        {"stage": "insight", "displayName": "返潮绳结", "text": "它不是让人回到过去的法术，只让不同立场的人承认自己曾在同一条危险的路上拉过同一根绳。", "effects": []}
      ],
      "properties": ["route", "testimony", "water"],
      "recipes": [],
      "hazards": ["route_closure"],
      "effects": [],
      "costs": [{"type": "worldConsequence", "key": "return_route_consumed"}],
      "unique": true,
      "droppable": true,
      "relatedCodexIds": ["CX-V01-MAT-RETURNKNOT"],
      "storyHooks": ["V01-C01-N128", "V01-C01-N018", "V02-REFUGE-ROUTE"]
    },
    {
      "id": "IT-V01-MAT-DAYSALTDUST",
      "name": "昼盐浮尘",
      "category": "material",
      "rarity": "uncommon",
      "sourceTags": ["原创材料"],
      "origin": "雨后空碗中不断分裂又消失的昼盐残末",
      "sensoryText": "细盐在瓶中像一口没呼完的气，靠近饥饿或分配争执时会微微发亮。",
      "recognitionStages": [
        {"stage": "first_sight", "displayName": "会变多的盐末", "text": "看似能把不够的东西分成更多份，实际每多出一粒就有一粒失去滋味。", "effects": []},
        {"stage": "verified", "displayName": "昼盐浮尘", "text": "可标记一项被统计掩盖的资源缺口；不能创造食物或药物，只让被忽略的不足重新显形。", "effects": [{"type": "unlockAction", "action": "reveal_allocation_gap"}]},
        {"stage": "insight", "displayName": "昼盐浮尘", "text": "它复制的不是盐，而是人们希望『总量够用』时愿意忽略的缺口。", "effects": []}
      ],
      "properties": ["salt", "resource", "revelation"],
      "recipes": [],
      "hazards": ["false_abundance"],
      "effects": [],
      "costs": [],
      "unique": false,
      "droppable": true,
      "relatedCodexIds": ["CX-V01-MAT-DAYSALTDUST"],
      "storyHooks": ["V01-C01-N165", "V01-C01-N022", "V02-RATION-AUDIT"]
    },
    {"id":"IT-V01-MAT-HEARTHASH","name":"药灶灰","category":"material","rarity":"common","sourceTags":["原创材料"],"origin":"粮仓药锅烧干后留下的温灰","sensoryText":"捻开有药根和湿柴气味。","recognitionStages":[{"stage":"first_sight","displayName":"温灰","text":"仍能辨出药锅最后煮过什么。","effects":[]},{"stage":"verified","displayName":"药灶灰","text":"可比对药物是否被稀释；会暴露分配记录的缺口。","effects":[{"type":"unlockAction","action":"audit_medicine"}]}],"properties":["medicine","evidence"],"recipes":[],"hazards":[],"effects":[],"costs":[],"unique":false,"droppable":true,"relatedCodexIds":[],"storyHooks":["V01-C01-N151","V02-MEDICINE"]},
    {"id":"IT-V01-MAT-LOANSTONE","name":"欠量石","category":"material","rarity":"uncommon","sourceTags":["原创材料"],"origin":"旧粮秤底压住的缺重石","sensoryText":"石面刻着被磨浅的刻度。","recognitionStages":[{"stage":"first_sight","displayName":"缺重秤石","text":"握着比看上去沉。","effects":[]},{"stage":"verified","displayName":"欠量石","text":"能校出被压低的粮食与药物缺口。","effects":[{"type":"unlockAction","action":"measure_shortfall"}]}],"properties":["resource","evidence"],"recipes":[],"hazards":["public_dispute"],"effects":[],"costs":[],"unique":true,"droppable":true,"relatedCodexIds":[],"storyHooks":["V01-C01-N151","V02-RATION-AUDIT"]},
    {"id":"IT-V01-MAT-RUSTDYE","name":"锈雨染料","category":"material","rarity":"common","sourceTags":["原创材料"],"origin":"染坊未染完的避雨布边角","sensoryText":"深蓝里有铁锈般的红光。","recognitionStages":[{"stage":"first_sight","displayName":"雨染布末","text":"遇水会显出经手人的指纹。","effects":[]},{"stage":"verified","displayName":"锈雨染料","text":"可标记共享物资的流转，不会证明占有是否合法。","effects":[{"type":"unlockAction","action":"mark_custody"}]}],"properties":["dye","custody"],"recipes":[],"hazards":[],"effects":[],"costs":[],"unique":false,"droppable":true,"relatedCodexIds":[],"storyHooks":["V01-C01-N152","V02-CUSTODY"]},
    {"id":"IT-V01-MAT-COLDWAX","name":"冷封蜡","category":"material","rarity":"uncommon","sourceTags":["原创材料"],"origin":"被黑雨淬冷的染坊封蜡","sensoryText":"贴纸即硬，贴掌则缓慢化开。","recognitionStages":[{"stage":"first_sight","displayName":"不化的封蜡","text":"可暂护一页湿纸。","effects":[]},{"stage":"verified","displayName":"冷封蜡","text":"能封存证据抄本一次；封存者姓名会留在蜡面。","effects":[{"type":"unlockAction","action":"seal_testimony"}]}],"properties":["evidence","seal"],"recipes":[],"hazards":["custody_exposure"],"effects":[],"costs":[],"unique":false,"droppable":true,"relatedCodexIds":[],"storyHooks":["V01-C01-N152","V02-TESTIMONY"]},
    {"id":"IT-V01-MAT-WATCHWICK","name":"守夜灯芯","category":"material","rarity":"common","sourceTags":["原创材料"],"origin":"北滩失而复得的守夜灯","sensoryText":"点燃后火焰总朝脚印方向倾。","recognitionStages":[{"stage":"first_sight","displayName":"偏火灯芯","text":"火焰不肯直立。","effects":[]},{"stage":"verified","displayName":"守夜灯芯","text":"可照出近期来回的脚印，但不替使用者判断动机。","effects":[{"type":"unlockAction","action":"trace_returning_steps"}]}],"properties":["light","tracking"],"recipes":[],"hazards":[],"effects":[],"costs":[],"unique":false,"droppable":true,"relatedCodexIds":[],"storyHooks":["V01-C01-N153","V02-NIGHT-WATCH"]},
    {"id":"IT-V01-MAT-TRACKDUST","name":"回脚泥粉","category":"material","rarity":"common","sourceTags":["原创材料"],"origin":"北滩单鞋脚印旁的细泥","sensoryText":"撒在地上会慢半拍沾回鞋底。","recognitionStages":[{"stage":"first_sight","displayName":"迟沾的泥粉","text":"能记一段脚步的方向。","effects":[]},{"stage":"verified","displayName":"回脚泥粉","text":"可保留足迹供当事人核对，不能判断足迹有罪。","effects":[{"type":"unlockAction","action":"preserve_tracks"}]}],"properties":["tracking","evidence"],"recipes":[],"hazards":["false_accusation"],"effects":[],"costs":[],"unique":false,"droppable":true,"relatedCodexIds":[],"storyHooks":["V01-C01-N153","V02-TRACKS"]},
    {"id":"IT-V01-MAT-GOATBELL","name":"小满铃片","category":"material","rarity":"common","sourceTags":["原创材料"],"origin":"小满旧铃上掉下的一片铜舌","sensoryText":"不摇也会在岔路口轻响。","recognitionStages":[{"stage":"first_sight","displayName":"旧铃片","text":"靠近被迫留下的生物时发热。","effects":[]},{"stage":"verified","displayName":"小满铃片","text":"可提示一条被忽略的离开路径；不能替任何生命选择去留。","effects":[{"type":"unlockAction","action":"hear_exit"}]}],"properties":["animal","route"],"recipes":[],"hazards":[],"effects":[],"costs":[],"unique":true,"droppable":true,"relatedCodexIds":[],"storyHooks":["V01-C01-N154","V02-ROUTE"]},
    {"id":"IT-V01-MAT-NAMESAP","name":"留名桑汁","category":"material","rarity":"uncommon","sourceTags":["原创材料"],"origin":"东桑根须渗出的浅金树汁","sensoryText":"在木牌上写字会三日不褪。","recognitionStages":[{"stage":"first_sight","displayName":"浅金树汁","text":"字会随念名的人变亮。","effects":[]},{"stage":"verified","displayName":"留名桑汁","text":"可使一项公开名单耐雨三日；会暴露书写者与保管者。","effects":[{"type":"unlockAction","action":"preserve_name"}]}],"properties":["name","record"],"recipes":[],"hazards":["custody_exposure"],"effects":[],"costs":[],"unique":false,"droppable":true,"relatedCodexIds":[],"storyHooks":["V01-C01-N154","V02-NAMES"]},
    {"id":"IT-V01-MAT-DRYREEDPAPER","name":"干芦纸","category":"material","rarity":"common","sourceTags":["原创材料"],"origin":"囚雨芦外层剥下晒干的薄膜","sensoryText":"浸水后才显出写过的笔迹。","recognitionStages":[{"stage":"first_sight","displayName":"透明薄纸","text":"干时几乎无字。","effects":[]},{"stage":"verified","displayName":"干芦纸","text":"可制作可水验抄本，遇伪造会先显墨晕。","effects":[{"type":"unlockAction","action":"water_verify_copy"}]}],"properties":["paper","evidence"],"recipes":[],"hazards":[],"effects":[],"costs":[],"unique":false,"droppable":true,"relatedCodexIds":[],"storyHooks":["V01-C01-N172","V02-COPIES"]},
    {"id":"IT-V01-MAT-REDFILAMENT","name":"盐层红丝","category":"material","rarity":"rare","sourceTags":["原创材料"],"origin":"人话盐层侧脸口中牵出的红线","sensoryText":"贴近谎言时会绷紧，贴近沉默时会松。","recognitionStages":[{"stage":"first_sight","displayName":"会绷的红线","text":"会指向未说完的句子。","effects":[]},{"stage":"verified","displayName":"盐层红丝","text":"可连接两条独立证词供交叉核验，连接错误会放大误认。","effects":[{"type":"unlockAction","action":"cross_check_testimony"}]}],"properties":["testimony","binding"],"recipes":[],"hazards":["false_link"],"effects":[],"costs":[],"unique":true,"droppable":true,"relatedCodexIds":[],"storyHooks":["V01-C01-N172","V02-TESTIMONY"]},
