      "costs": [],
      "unique": false,
      "droppable": true,
      "relatedCodexIds": [],
      "storyHooks": ["EN-V01-MICRO-SHADOWDOG"]
    },
    {
      "id": "IT-V01-MAT-RAINREED",
      "name": "囚雨芦",
      "category": "material",
      "rarity": "uncommon",
      "sourceTags": ["原创材料"],
      "origin": "停流赤水河床上短暂生长的透明芦苇",
      "sensoryText": "透明芦节内囚着一滴黑雨，贴耳可听见被洗去的低语。",
      "recognitionStages": [
        {"stage": "first_sight", "displayName": "含雨的透明芦节", "text": "折断可能释放黑雨。", "effects": []},
        {"stage": "verified", "displayName": "囚雨芦", "text": "储存黑雨并保持其方向性，可诱导或过载以遗忘为食的异物。", "effects": [{"type": "unlockAction", "action": "release_captive_rain"}]},
        {"stage": "insight", "displayName": "囚雨芦", "text": "其空腔是微小的逆流，可保存一段环境状态而非普通液体。", "effects": [{"type": "unlockAction", "action": "preserve_weather_state"}]}
      ],
      "properties": ["water", "memory", "container"],
      "recipes": ["RC-V01-RAINWARD"],
      "hazards": ["black_rain_exposure"],
      "effects": [],
      "costs": [],
      "unique": false,
      "droppable": true,
      "relatedCodexIds": ["CX-V01-MAT-RAINREED"],
      "storyHooks": ["V01-C01-N017"]
    },
