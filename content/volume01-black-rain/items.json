      "origin": "异生桑林第十只鸟巢",
      "sensoryText": "巢内永远比外界暗一层，靠近日光时会渗出黑雨。",
      "recognitionStages": [
        {"stage": "first_sight", "displayName": "落满黑雨的空巢", "text": "可遮蔽一件小物的光与热。", "effects": []},
        {"stage": "verified", "displayName": "受雨空巢", "text": "短暂隐藏太阳性物品的气息；使用会削弱东桑林稳定。", "effects": [{"type": "unlockAction", "action": "hide_solar_trace"}]}
      ],
