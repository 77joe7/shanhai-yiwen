      "rarity": "rare",
      "sourceTags": ["原创器物"],
      "origin": "封存含晦散出的无主言语",
      "sensoryText": "罐内不断有人想起一句话；开盖会使相应记忆返回原主。",
      "recognitionStages": [{"stage": "verified", "displayName": "含晦话罐", "text": "保存证词，可在后续交涉中开盖作证；开盖后内容与物品同时失去。", "effects": [{"type": "unlockAction", "action": "release_testimony"}]}],
      "effects": [], "costs": [{"type": "consume", "amount": 1}], "unique": true, "droppable": true, "owner": "PLAYER",
