  "items": [
    {
      "id": "IT-V01-MAT-EMBERLEAF",
      "name": "扶桑烬",
      "category": "material",
      "rarity": "uncommon",
      "sourceTags": ["扶桑意象演化", "原创材料"],
      "origin": "被黑雨冲落、来自异生桑叶的金色余烬",
      "sensoryText": "一撮雨浇不灭的金灰，有晒热被褥和遥远夏日的气味。",
      "recognitionStages": [
        {"stage": "first_sight", "displayName": "烧不尽的灰", "text": "贴近皮肤会发暖，黑雨无法浇灭。", "effects": []},
        {"stage": "rumor", "displayName": "日灰", "text": "阿禾说东桑林亮过；缄婆称它是被剪碎的白天。", "effects": [{"type": "unlockAction", "action": "test_with_clean_water"}]},
        {"stage": "verified", "displayName": "扶桑烬", "text": "可照见被黑雨洗去的一句话；每次使用随机褪去一件私人小记忆。", "effects": [{"type": "unlockAction", "action": "reveal_erased_words"}]},
        {"stage": "insight", "displayName": "扶桑烬", "text": "并非燃烧残余，而是某段白昼从世界记录中被抹去后的余温；能干预与日名、未来箭痕有关的事件。", "effects": [{"type": "unlockAction", "action": "interfere_sun_record"}]}
      ],
      "properties": ["light", "memory", "revelation"],
      "recipes": ["RC-V01-REVEALING-WATER"],
      "hazards": ["memory_loss"],
      "effects": [],
      "costs": [{"type": "memory", "amount": 1}],
      "unique": false,
      "droppable": true,
      "relatedCodexIds": ["CX-V01-MAT-EMBERLEAF"],
      "storyHooks": ["V01-C01-N014", "V01-C01-N018"]
    },
    {
