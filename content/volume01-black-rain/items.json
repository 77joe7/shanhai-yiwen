      "recognitionStages": [
        {"stage": "first_sight", "displayName": "不跟光走的泥", "text": "放在灯下时影子停在原位。", "effects": []},
        {"stage": "verified", "displayName": "滞影泥", "text": "可固定小型影迹，延缓依靠影子移动的对象一节拍。", "effects": [{"type": "unlockAction", "action": "pin_shadow"}]}
      ],
      "properties": ["shadow", "binding"],
      "recipes": ["RC-V01-SHADOW-SEAL"],
      "hazards": ["temporary_shadow_loss"],
