    },
    {
      "id": "IT-V01-UNIQUE-REDARROWHEAD",
      "name": "未命之镞",
      "category": "unique",
      "rarity": "mythic",
      "sourceTags": ["羿与射日神话演化", "原创器物"],
      "origin": "玩家折断未来赤金箭后留在人间的箭镞",
      "sensoryText": "已冷却的赤金箭镞，不再指向固定目标；被谁握住便短暂映出谁最想射落之物。",
      "recognitionStages": [{"stage": "verified", "displayName": "未命之镞", "text": "能破坏一次‘目标已被命定’的规则；使用者的敌意会成为新的指向。", "effects": [{"type": "unlockAction", "action": "deny_destined_target"}]}, {"stage": "insight", "displayName": "未命之镞", "text": "它并非自由本身，只把指定目标的权力从神手中转给持有者。", "effects": []}],
