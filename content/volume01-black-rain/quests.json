  "quests": [
    {
      "id": "Q-V01-MAIN-001",
      "name": "雨在落下以前",
      "type": "main",
      "summary": "黑雨降临杳湾，处理第一场危机并参加村中议事。",
      "objectives": [
        {"id": "choose_first_response", "text": "回应村中第一场危机", "completion": [{"type": "visitedAnyNode", "nodeIds": ["V01-C01-N002", "V01-C01-N003", "V01-C01-N004", "V01-C01-N005"]}]},
        {"id": "reach_council", "text": "前往祠屋参加议事", "completion": [{"type": "visitedNode", "nodeId": "V01-C01-N006"}]}
      ],
      "rewards": [{"type": "unlockQuest", "questId": "Q-V01-MAIN-002"}],
      "failure": null,
      "relatedNpcIds": ["NPC-AHE", "NPC-YANBO", "NPC-JIANPO"],
      "relatedItemIds": ["IT-V01-MAT-EMBERLEAF", "IT-V01-TOOL-CRACKEDWHISTLE"]
    },
    {
      "id": "Q-V01-MAIN-002",
      "name": "三影尸体",
      "type": "main",
      "summary": "调查北滩无名尸的箭、三道影子与残日骨牌。",
      "objectives": [
        {"id": "inspect_one_clue", "text": "至少确认一项核心异状", "completion": [{"type": "anyFlagTrue", "keys": ["clue.arrow_name_yi", "clue.shadow_memory_ten", "clue.bone_token_fusang"]}]},
        {"id": "survive_second_moon", "text": "见证第二个月亮升起", "completion": [{"type": "visitedNode", "nodeId": "V01-C01-N012"}]}
      ],
      "optionalObjectives": [
        {"id": "collect_all_corpse_clues", "text": "在证据受损前确认全部三项异状", "completion": [{"type": "allFlagsTrue", "keys": ["clue.arrow_name_yi", "clue.shadow_memory_ten", "clue.bone_token_fusang"]}]}
      ],
      "rewards": [{"type": "unlockCodex", "codexId": "CX-V01-PERSON-THREESHADOW", "layer": "rumor"}],
      "failure": {"kind": "fail_forward", "result": "corpse_clues_incomplete"},
      "relatedNpcIds": ["NPC-WEIQING", "NPC-THREESHADOW"],
      "relatedItemIds": ["IT-V01-CLUE-ARROWRUBBING", "IT-V01-CLUE-DAYTOKEN"]
    },
    {
      "id": "Q-V01-MAIN-003",
      "name": "赤水倒流",
      "type": "main",
      "summary": "在倒流河床、异生桑林或尸祭传闻中求证黑雨的去向。",
      "objectives": [
        {"id": "follow_one_route", "text": "完成一条求证路线", "completion": [{"type": "visitedAnyNode", "nodeIds": ["V01-C01-N013", "V01-C01-N014", "V01-C01-N015"]}]},
        {"id": "verify_material", "text": "完成一次材料显形", "completion": [{"type": "itemRecognitionAtLeast", "itemId": "IT-V01-MAT-EMBERLEAF", "stage": "verified"}], "optional": true}
      ],
      "rewards": [{"type": "unlockLocation", "locationId": "LOC-DAYSALT-WELL"}],
      "failure": {"kind": "time_cost", "worldEffects": [{"type": "changeWorldVar", "key": "village.water_sickness", "delta": 1}]},
      "relatedNpcIds": ["NPC-AHE", "NPC-SUSHA", "NPC-YANTONG"],
      "relatedItemIds": ["IT-V01-MAT-RAINREED", "IT-V01-MAT-NIGHTFEATHER", "IT-V01-MAT-EMBERLEAF"]
    },
    {
      "id": "Q-V01-MAIN-004",
      "name": "井底白昼",
      "type": "main",
      "summary": "进入旧盐井，以战斗、诱离、过载或揭言解决含晦。",
      "objectives": [
        {"id": "enter_well", "text": "抵达昼盐池", "completion": [{"type": "visitedNode", "nodeId": "V01-C01-N017"}]},
        {"id": "resolve_hanhui", "text": "解决含晦遭遇", "completion": [{"type": "worldVarIn", "key": "hanhui.fate", "values": ["contained", "dispersed", "killed"]}, {"type": "anyFlagTrue", "keys": ["hanhui.first_words_revealed"]}]}
      ],
      "rewards": [{"type": "addItemConditional", "itemIds": ["IT-V01-CLUE-ARROWMOLD", "IT-V01-UNIQUE-VOICEJAR", "IT-V01-MAT-WORDLESSBONE"]}],
      "failure": {"kind": "fail_forward", "result": "retreat_and_village_sickness"},
      "relatedNpcIds": ["NPC-JIANPO"],
      "relatedItemIds": ["IT-V01-MAT-EMBERLEAF", "IT-V01-MAT-RAINREED", "IT-V01-TOOL-CRACKEDWHISTLE"]
    },
    {
      "id": "Q-V01-MAIN-005",
      "name": "让谁先知道",
      "type": "main",
      "summary": "在黑雨第七日决定三影者、赤金箭与杳湾的去向。",
      "objectives": [
        {"id": "hear_yi", "text": "向羿交代调查所得", "completion": [{"type": "visitedNode", "nodeId": "V01-C01-N021"}]},
        {"id": "choose_final_plan", "text": "决定谁承担守护或夺取尸体的代价", "completion": [{"type": "worldVarExists", "key": "finale.plan"}]},
        {"id": "resolve_arrow", "text": "决定赤金箭的归属", "completion": [{"type": "worldVarExists", "key": "unique.red_arrow.owner"}]}
      ],
      "rewards": [{"type": "unlockContent", "contentId": "V02-PREVIEW"}],
      "failure": null,
      "relatedNpcIds": ["NPC-YI", "NPC-THREESHADOW", "NPC-JILI", "NPC-LIWEI"],
      "relatedItemIds": ["IT-V01-CLUE-ARROWMOLD", "IT-V01-UNIQUE-REDARROWHEAD"]
    },
    {
      "id": "Q-V01-SIDE-003",
      "name": "替尸体做梦的人",
      "type": "side",
      "summary": "查明夜间供物的来源，决定是否公开砚童被梦操纵的事实。",
      "objectives": [{"id": "follow_offerings", "text": "在双月重合时守候供物", "completion": [{"type": "visitedNode", "nodeId": "V01-C01-N015"}]}],
      "rewards": [{"type": "addItem", "itemId": "IT-V01-MAT-NIGHTFEATHER", "quantity": 1}],
      "failure": {"kind": "expiry", "when": [{"type": "chapterAfter", "chapter": "ACT4_NIGHT_WITHOUT_SUN"}], "result": "yantong_remains_dream_bound"},
      "relatedNpcIds": ["NPC-YANTONG", "NPC-YANBO"],
      "relatedItemIds": ["IT-V01-MAT-NIGHTFEATHER"]
    }
  ]
}
